{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "name": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "databasePassword": {
      "value": "$(secretOrRandomPassword ${AZURE_KEY_VAULT_NAME} databasePassword)"
    },
    "existingVnetRgName": {
      "value": "Sequoia-Combine-RG"
    },
    "existingVnetName": {
      "value": "Combine"
    },
    "appSubnetName": {
      "value": "Combine-Customer-B"
    },
    "dbSubnetName": {
      "value": "Combine-Customer-A"
    },
    "vaultSubnetName": {
      "value": "Combine-Customer-D"
    },
    "cacheSubnetName": {
      "value": "Combine-Customer-C"
    }
  }
}